rules_version = '2';

// ============================================================
//  Al-ThayyiBoon Matrimony – Optimized Firestore Security Rules
//  Project: althayyiboon-e6f3d
//
//  Configured for frictionless candidate registration during
//  the active Free Campaign Drive while structuring collections
//  cleanly for profiles, customFilters, filterRequests, and settings.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles collection: Public read, registration submission, and profile updates
    match /profiles/{profileId} {
      allow read, write: if true;
    }

    // Dynamic custom taxonomy and filter requests
    match /customFilters/{filterId} {
      allow read, write: if true;
    }

    match /filterRequests/{requestId} {
      allow read, write: if true;
    }

    // App configuration, pricing, campaign settings, and health check
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Admin backup snapshots
    match /backups/{backupId} {
      allow read, write: if true;
    }

    // Unrestricted fallback to ensure zero registration blockages during campaign
    match /{document=**} {
      allow read, write: if true;
    }

  }
}
