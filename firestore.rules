rules_version = '2';

// ============================================================
//  Al-ThayyiBoon Matrimony – Open Firestore Security Rules
//  Project: althayyiboon-8c49d
//
//  Allows public read and write access for all collections:
//  - /profiles (create, read, update, delete)
//  - /filterRequests
//  - /customFilters
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow unrestricted read and write access to all documents
    match /{document=**} {
      allow read, write: if true;
    }

  }
}
